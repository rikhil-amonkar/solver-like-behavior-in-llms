# DeepSeek API (inference with --model deepseek)
DEEPSEEK_API_KEY=sk-your-key-here
MAX_DEEPSEEK_TOKENS=131072

# Local models (vLLM). Generation is clamped to each model's 131072-token context.
HF_TOKEN=
MAX_QWEN_TOKENS=131072
MAX_OPENAI_TOKENS=131072

# Gemini judge on Vertex AI (chunking and hardcoded detection)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
JUDGE_VERTEX_GCS_BUCKET=your-bucket
VERTEX_JUDGE_BATCH_MODEL=publishers/google/models/gemini-2.5-pro
MAX_JUDGE_TOKENS=65536
